# ==============================================================================
# AMIT AI CONCIERGE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Amit AI Concierge"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Frontend URL (for CORS and Widget validation)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secure_random_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Administrator Credentials (used during initial database seed)
INITIAL_ADMIN_EMAIL=admin@amithospitality.com
INITIAL_ADMIN_PASSWORD=AmitConcierge2026!Secure

# Database Configuration
# Local SQLite fallback for development (default):
DATABASE_URL=sqlite:///./amit_concierge.db
# Production PostgreSQL with pgvector (uncomment for production/Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/amit_concierge

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Active Environment Initial Setting (DEMO | REAL)
DEFAULT_ENVIRONMENT=DEMO

# AI Provider Configuration
# Supported providers: gemini | openai | mock (for offline testing)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Configuration
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=2000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
