# ==============================================================================
# AMIT AI CONCIERGE — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# Official Platform for Amit Hospitality (https://amithospitality.com/)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env and configure variables for your target deployment:
# - Local Development: uses SQLite + local vector fallback + DEBUG=true
# - Staging / Production: requires PostgreSQL + pgvector + strong JWT secrets + DEBUG=false
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | demo | staging | production
APP_ENV=development
APP_NAME="Amit AI Concierge"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Initial Knowledge Mode: DEMO or REAL
DEFAULT_ENVIRONMENT=DEMO

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND DOMAIN RESTRICTIONS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://amithospitality.com"

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + pgvector / SQLite)
# ------------------------------------------------------------------------------
# Local Development (SQLite default):
DATABASE_URL=sqlite:///./amit_concierge.db

# Production & Staging (PostgreSQL with pgvector):
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/amit_concierge

# Connection Pool Settings (PostgreSQL production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 4. SECURITY, JWT AUTHENTICATION & REPLAY PROTECTION
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate a 64-character random key using: openssl rand -hex 32
# If APP_ENV=production, the platform will refuse to start if using placeholder values.
JWT_SECRET_KEY=change_this_to_a_super_secure_random_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Administrator Credentials (used during initial database bootstrap)
INITIAL_ADMIN_EMAIL=admin@amithospitality.com
INITIAL_ADMIN_PASSWORD=AmitConcierge2026!Secure

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT PIPELINE
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS & LLM INFERENCE (Grounded RAG)
# ------------------------------------------------------------------------------
# Provider: gemini | openai | local
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# OpenAI Fallback (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG Search Tuning
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.15

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY ENTERPRISE INTEGRATIONS
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Requires verified Meta Business Account)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Twilio Telephony, Voice AI & SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Transactional Email (SendGrid or SMTP)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=concierge@amithospitality.com

# ------------------------------------------------------------------------------
# 8. GUEST RELATIONS HOTLINES & HUMAN ESCALATION
# ------------------------------------------------------------------------------
HOTLINE_PHONE_NUMBER="+91 11 4050 9900"
HOTLINE_EMAIL="guestrelations@amithospitality.com"
ESCALATION_PHONE_NUMBER="+911140509900"

# ------------------------------------------------------------------------------
# 9. DISTRIBUTED CACHING, RATE LIMITING & MONITORING
# ------------------------------------------------------------------------------
# Redis (Optional: distributed sliding-window rate limiting across cluster instances)
# REDIS_URL=redis://localhost:6379/0

# Sentry Application Performance Monitoring (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
